# Names of the variables in /home/forge/darkroom.jerome-arfouche.ca/.env (values omitted).
# Consumed by infra/forge_deploy.sh only.
PNPM_PATH=
# Sentry (build-time; Vite bakes VITE_* into the bundle). Auth token/org/project
# are only needed to upload sourcemaps; without SENTRY_AUTH_TOKEN none are generated.
VITE_SENTRY_DSN=
VITE_SENTRY_RELEASE=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
